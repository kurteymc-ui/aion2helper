        </Style>
        <!-- A separator in a menu: one thin line over the whole width of the menu (the default one is indented for an icon column and ends short). -->
        <ControlTemplate x:Key="MenuSeparatorLine" TargetType="Separator">
            <Border Height="1" Margin="6,4" HorizontalAlignment="Stretch" Background="{DynamicResource Brush.Border}"/>
        </ControlTemplate>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template" Value="{StaticResource MenuSeparatorLine}"/>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}"/>
        <!-- Found by the user: a ToolTip popup (e.g. the Char-quick-switch's, back when it still
             existed) rendered as a bright white box - same popup-chrome issue as everything above, ToolTip's default template
             ignores Background/Foreground the same way. Simple setters ARE enough here (ToolTip's
             default template is a plain bordered box, no bevel/3D chrome to fight). -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Brush.Panel}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}" MaxWidth="380">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Found by terminal_windows measuring pixels again: a CheckBox's own box (the now-removed
             PlayersOnlyFilter toggle, back when it still existed) drew pure white - the same family
             of bug as the disabled-Button chrome earlier, a Foreground setter never reaches the box,
             only its default template does. Full template: a small dark Border for the box, a
             checkmark Path shown only when checked. Kept for the CheckBoxes still in this window's
             menus and any future toggle. -->
        <Style TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="16" Height="16" Background="{DynamicResource Brush.Control}" CornerRadius="4"
                                    BorderBrush="{DynamicResource Brush.CheckBorder}" BorderThickness="1" Margin="0,0,8,0">
                                <Path x:Name="Check" Data="M 2,7 L 6,11 L 12,3" Stroke="{DynamicResource Brush.Text}"
                                      StrokeThickness="1.6" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.CheckBorderHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
